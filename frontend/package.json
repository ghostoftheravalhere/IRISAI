{
  "name": "iris-ai",
  "version": "0.1.0",
  "description": "IRIS AI — Intelligent Responsive Interface System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "electron": "electron .",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "vite": "^5.2.12",
    "wait-on": "^7.2.0"
  }
}